generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("postgresql://bookkeeping_db_e4xj_user:xreo9wBGFfCR9GbJhzgcIifNIBFt3bOh@dpg-dbdkn5on74is7394ool0-a.singapore-postgres.render.com/bookkeeping_db_e4xj")
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  passwordHash  String
  createdAt     DateTime          @default(now())
  progress      ChapterProgress[]
  quizAttempts  QuizAttempt[]
}

model ChapterProgress {
  id          String   @id @default(cuid())
  userId      String
  chapterSlug String
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterSlug])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  chapterSlug String
  score       Int
  total       Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
